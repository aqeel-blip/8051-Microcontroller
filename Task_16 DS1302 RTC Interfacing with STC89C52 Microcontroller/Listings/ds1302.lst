  19   2              dat >>= 1;
  20   2          }
  21   1      }
  22          
  23          // Low-level bit-bang read (LSB first)
  24          static unsigned char DS1302_ReadByte(void) {
  25   1          unsigned char i, dat = 0;
  26   1          for (i = 0; i < 8; i++) {
  27   2              dat >>= 1;
  28   2              if (DS1302_IO) {
  29   3                  dat |= 0x80;
  30   3              }
  31   2              DS1302_SCLK = 1;
  32   2              DS1302_SCLK = 0;
  33   2          }
  34   1          return dat;
  35   1      }
