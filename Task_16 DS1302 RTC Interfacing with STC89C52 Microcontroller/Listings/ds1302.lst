  12          // Low-level bit-bang write (LSB first)
  13          static void DS1302_WriteByte(unsigned char dat) {
  14   1          unsigned char i;
  15   1          for (i = 0; i < 8; i++) {
  16   2              DS1302_IO = dat & 0x01;
  17   2              DS1302_SCLK = 1;
