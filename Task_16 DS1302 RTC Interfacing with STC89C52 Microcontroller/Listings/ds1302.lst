  66          // Write complete time/date structure
  67          void DS1302_SetTime(DS1302_Time *time) {
  68   1          DS1302_WriteReg(DS1302_WP_WRITE, 0x00); // Disable write protection
  69   1          
  70   1          DS1302_WriteReg(DS1302_SEC_WRITE, DecToBCD(time->sec));
