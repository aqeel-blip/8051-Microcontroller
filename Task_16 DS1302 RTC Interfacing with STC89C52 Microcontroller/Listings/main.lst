  56          // --- DS1302 Low-Level Driver ---
  57          void ds1302_write_byte(unsigned char dat) {
  58   1          unsigned char i;
  59   1          for(i = 0; i < 8; i++) {
  60   2              DS1302_IO = dat & 0x01;
  61   2              DS1302_SCLK = 1; _nop_();
  62   2              DS1302_SCLK = 0; _nop_();
  63   2              dat >>= 1;
  64   2          }
  65   1      }
  66          
  67          unsigned char ds1302_read_byte(void) {
  68   1          unsigned char i, dat = 0;
  69   1          for(i = 0; i < 8; i++) {
  70   2              dat >>= 1;
  71   2              if(DS1302_IO) dat |= 0x80;
  72   2              DS1302_SCLK = 1; _nop_();
  73   2              DS1302_SCLK = 0; _nop_();
  74   2          }
  75   1          return dat;
  76   1      }
  77          
  78          void ds1302_write_reg(unsigned char reg, unsigned char dat) {
