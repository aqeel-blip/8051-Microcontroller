   3          /* ================= A2 BOARD PIN MAP =================
   4           * LCD1602 : D0-D7 = P0.0-P0.7, RS = P2.6, RW = P2.5, EN = P2.7
   5           * KEYPAD  : rows = P1.7-P1.4 (inputs), columns = P1.3-P1.0 (outputs)
   6           * BUZZER  : P2.5  (on A2 board buzzer SHARES P2.5 with LCD RW - this is
   7           *                  normal! LCD only reads RW while EN pulses, and we
   8           *                  never pulse EN during beeps, so both work fine)
   9           * RELAY   : external module, IN -> P3.7   (RELAY_ON/RELAY_OFF below)
  10           * DOOR    : external switch, P3.6 to GND  (0 = open, 1 = closed)
  11           * CRYSTAL : 12 MHz  -> 50 ms tick = 50000 counts -> reload 0x3CB0
  12           * ==================================================== */
  13          
  14          sbit LCD_RS = P2^6;
  15          sbit LCD_RW = P2^5;      /* same pin as buzzer on A2 - keep at 0 except beeps */
  16          sbit LCD_EN = P2^7;
  17          
  18          sbit BUZZ  = P2^5;       /* passive buzzer: needs toggling, not DC */
  19          
  20          sbit RELAY = P3^7;       /* external relay module */
  21          sbit DOOR  = P3^6;       /* door switch to GND: 0 = open, 1 = closed */
  22          
  23          #define RELAY_ON   0     /* <-- active-LOW relay setting */
  24          #define RELAY_OFF  1
  25          
  26          /* ---------- Function Declarations ---------- */
  27          void Beep(unsigned int duration);
  28          void delay_ms(unsigned int ms);
  29          void delay_500us(void);
  30          
  31          /* ---------- FSM states ---------- */
  32          enum { ST_IDLE, ST_SET, ST_RUNNING, ST_PAUSED, ST_DOOR_OPEN, ST_DONE };
  33          unsigned char state = ST_IDLE;
  34          
  35          unsigned int entry_val = 0;   /* digits typed, 123 means 1:23 */
  36          unsigned int total_sec = 0;   /* cooking time in seconds      */
  37          
  38          volatile unsigned char one_sec = 0;   /* set by Timer0 ISR */
  39          
  40          /* ---------- software delays (12 MHz crystal) ---------- */
  41          void delay_ms(unsigned int ms)      /* ~1 ms per unit */
  42          {
  43   1          unsigned int i, j;
  44   1          for (i = 0; i < ms; i++)
  45   1              for (j = 0; j < 110; j++);
  46   1      }
  47          void delay_500us(void)              /* half period for ~1 kHz buzzer tone */
  48          {
  49   1          unsigned int j;
  50   1          for (j = 0; j < 250; j++);
  51   1      }
  52          
  53          /* ---------- buzzer (passive: toggle at ~1 kHz; restore pin to 0) ---------- */
  54          void Beep(unsigned int duration)
C51 COMPILER V9.60.7.0   MAIN                                                              09/16/2026 14:36:50 PAGE 2   

  55          {
  56   1          unsigned int i;
  57   1          for (i = 0; i < duration; i++)
  58   1          {
  59   2              BUZZ = 1; delay_500us();
  60   2              BUZZ = 0; delay_500us();
  61   2          }
  62   1          BUZZ = 0;                        /* back to LCD_RW = 0 (write mode) */
  63   1      }
  64          
  65          /* ================= LCD (HD44780, 8-bit, data on P0) ================= */
  66          void lcd_cmd(unsigned char c)
  67          {
  68   1          LCD_RS = 0; LCD_RW = 0; P0 = c;
  69   1          LCD_EN = 1; delay_ms(1); LCD_EN = 0; delay_ms(1);
  70   1      }
  71          void lcd_data(unsigned char d)
  72          {
  73   1          LCD_RS = 1; LCD_RW = 0; P0 = d;
  74   1          LCD_EN = 1; delay_ms(1); LCD_EN = 0; delay_ms(1);
  75   1      }
  76          void lcd_init(void)
  77          {
  78   1          delay_ms(20);        /* wait for LCD power-up */
  79   1          lcd_cmd(0x38);       /* 8-bit, 2 lines, 5x7 */
  80   1          lcd_cmd(0x0C);       /* display on, cursor off */
  81   1          lcd_cmd(0x06);       /* entry mode: increment */
  82   1          lcd_cmd(0x01);       /* clear */
  83   1          delay_ms(2);
  84   1      }
  85          void lcd_goto(unsigned char row, unsigned char col)
  86          {
  87   1          lcd_cmd(row ? 0xC0 + col : 0x80 + col);
  88   1      }
  89          void lcd_str(char *s)
  90          {
  91   1          while (*s) lcd_data(*s++);
  92   1      }
  93          
  94          /* ================= Timer0: 50 ms x 20 = 1 s (12 MHz) ================= */
  95          void timer0_init(void)
  96          {
  97   1          TMOD = (TMOD & 0xF0) | 0x01;  /* Timer0 mode 1, 16-bit */
  98   1          TH0  = 0x3C; TL0 = 0xB0;
  99   1          ET0 = 1; TR0 = 1; EA  = 1;
 100   1      }
 101          void t0_isr(void) interrupt 1
 102          {
 103   1          static unsigned char n = 0;
 104   1          TH0 = 0x3C; TL0 = 0xB0;       /* reload 50 ms */
 105   1          if (++n >= 20) { n = 0; one_sec = 1; }
 106   1      }
