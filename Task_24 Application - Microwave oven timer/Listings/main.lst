 108          /* ================= Keypad Scan ================= */
 109          unsigned char code KEYMAP[4][4] =
 110          {   {'*','0','#','D'},
 111              {'7','8','9','C'},
 112              {'4','5','6','B'},
 113              {'1','2','3','A'}   };
 114          
 115          unsigned char scan_keypad(void)
 116          {
C51 COMPILER V9.60.7.0   MAIN                                                              09/16/2026 14:36:50 PAGE 3   

 117   1          unsigned char col, r;
 118   1      
 119   1          for (col = 0; col < 4; col++)
 120   1          {
 121   2              P1 = 0xFF;                 /* all high */
 122   2              P1 &= ~(0x08 >> col);      /* drive one column LOW */
 123   2              r = P1 & 0xF0;             /* read rows P1.7-P1.4 */
 124   2              if (r != 0xF0)
 125   2              {
 126   3                  delay_ms(20);          /* debounce */
 127   3                  r = P1 & 0xF0;
 128   3                  if (r != 0xF0)
 129   3                  {
 130   4                      while ((P1 & 0xF0) != 0xF0);   /* wait for release */
 131   4                      switch (r)
 132   4                      {
 133   5                          case 0xE0: return KEYMAP[0][col];
 134   5                          case 0xD0: return KEYMAP[1][col];
 135   5                          case 0xB0: return KEYMAP[2][col];
 136   5                          case 0x70: return KEYMAP[3][col];
 137   5                          default:   return 0;
 138   5                      }
 139   4                  }
 140   3              }
 141   2          }
 142   1          return 0;
 143   1      }
