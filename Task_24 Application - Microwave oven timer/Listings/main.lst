 145          /* ================= Display helpers ================= */
 146          void show_time(void)
 147          {
 148   1          unsigned char m = total_sec / 60, s = total_sec % 60;
 149   1          char buf[6];
 150   1          buf[0] = '0' + m / 10;  buf[1] = '0' + m % 10;
 151   1          buf[2] = ':';
 152   1          buf[3] = '0' + s / 10;  buf[4] = '0' + s % 10;
 153   1          buf[5] = '\0';
 154   1          lcd_goto(0, 0);  lcd_str("Time:  ");
 155   1          lcd_str(buf);
 156   1      }
 157          void show_status(char *s)
 158          {
 159   1          lcd_goto(1, 0);  lcd_str("                ");
 160   1          lcd_goto(1, 0);  lcd_str(s);
 161   1      }
 162          
 163          void enter_digit(unsigned char d)
 164          {
 165   1          entry_val = entry_val * 10 + d;
 166   1          if (entry_val > 9959) entry_val = 9959;
 167   1          total_sec = (entry_val / 100) * 60 + (entry_val % 100);
 168   1          if (total_sec > 6039) total_sec = 6039;
 169   1      }
 170          
 171          void clear_all(void)
 172          {
 173   1          entry_val = 0; total_sec = 0; RELAY = RELAY_OFF;
 174   1      }
