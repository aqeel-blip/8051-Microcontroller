  57          void LCD_ShowString(unsigned char row, unsigned char col, char *str) {
  58   1          if(row == 0) LCD_WriteCmd(0x80 + col);
  59   1          else if(row == 1) LCD_WriteCmd(0xC0 + col);
  60   1          
  61   1          while(*str) {
  62   2              LCD_WriteData(*str++);
  63   2          }
  64   1      }
