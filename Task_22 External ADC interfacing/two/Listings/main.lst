 105          // --- Main Program Loop ---
 106          void main(void) {
 107   1          unsigned int adc_val;
 108   1          unsigned int voltage_mv; // Voltage scaled (0 to 500 = 0.00V to 5.00V)
 109   1      
 110   1          LCD_Init();
 111   1          LCD_ShowString(0, 0, "Voltmeter AIN0:");
 112   1      
 113   1          while(1) {
 114   2              // Command 0x94: Single-ended 12-bit mode for channel AIN0 (Potentiometer AD1)
 115   2              adc_val = ET2046_ReadADC(0x94);
 116   2      
C51 COMPILER V9.60.7.0   MAIN                                                              08/26/2026 15:43:04 PAGE 3   

 117   2              // Convert 12-bit ADC value (0-4095) to Voltage (0-500)
 118   2              voltage_mv = (unsigned long)adc_val * 500 / 4095;
 119   2      
 120   2              // Display voltage on LCD Line 2
 121   2              LCD_WriteCmd(0xC0); // Move cursor to Line 2, Column 0
 122   2              LCD_ShowString(1, 0, "Voltage: ");
 123   2              
 124   2              LCD_WriteData('0' + (voltage_mv / 100));        // Units digit (0-5)
 125   2              LCD_WriteData('.');
 126   2              LCD_WriteData('0' + ((voltage_mv / 10) % 10));  // Tenths digit
 127   2              LCD_WriteData('0' + (voltage_mv % 10));         // Hundredths digit
 128   2              LCD_WriteData('V');
 129   2              LCD_ShowString(1, 14, "  ");
 130   2      
 131   2              DelayMs(200); // Update display every 200 ms
 132   2          }
 133   1      }


