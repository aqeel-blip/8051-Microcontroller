  30          // --- LCD1602 Driver Functions ---
  31          void LCD_WriteCmd(unsigned char cmd) {
  32   1          LCD_RS = 0;
  33   1          LCD_RW = 0;
  34   1          LCD_PORT = cmd;
  35   1          LCD_EN = 1;
  36   1          DelayMs(1);
  37   1          LCD_EN = 0;
  38   1      }
  39          
  40          void LCD_WriteData(unsigned char dat) {
  41   1          LCD_RS = 1;
  42   1          LCD_RW = 0;
  43   1          LCD_PORT = dat;
  44   1          LCD_EN = 1;
  45   1          DelayMs(1);
  46   1          LCD_EN = 0;
  47   1      }
  48          
  49          void LCD_Init(void) {
  50   1          LCD_WriteCmd(0x38); // 8-bit mode, 2-line display, 5x7 matrix
  51   1          LCD_WriteCmd(0x0C); // Display ON, Cursor OFF
  52   1          LCD_WriteCmd(0x06); // Auto-increment cursor position
  53   1          LCD_WriteCmd(0x01); // Clear display screen
