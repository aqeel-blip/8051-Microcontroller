  66          // --- ET2046 SPI Read Function ---
  67          // --- Corrected ET2046 SPI Read Function ---
  68          unsigned int ET2046_ReadADC(unsigned char cmd) {
  69   1          unsigned char i;
  70   1          unsigned int adc_value = 0;
  71   1      
  72   1          DCLK = 0;
  73   1          CS = 0; // Select ET2046
  74   1      
  75   1          // 1. Send 8-bit control word on DIN
  76   1          for(i = 0; i < 8; i++) {
  77   2              DIN = (cmd >> (7 - i)) & 0x01;
  78   2              DCLK = 1;
  79   2              DCLK = 0;
  80   2          }
  81   1      
  82   1          // 2. Clock cycle 9: Conversion sampling transition
  83   1          // Falling edge of Clock 9 outputs MSB (D11) on DOUT pin
  84   1          DCLK = 1;
  85   1          DCLK = 0;
  86   1      
  87   1          // 3. Read 12-bit ADC result from DOUT
  88   1          for(i = 0; i < 12; i++) {
  89   2              adc_value <<= 1;
  90   2              
  91   2              // Read current bit FIRST
  92   2              if(DOUT) {
  93   3                  adc_value |= 0x01;
  94   3              }
  95   2      
  96   2              // Pulse DCLK to shift next bit out on DOUT for the next iteration
  97   2              DCLK = 1;
  98   2              DCLK = 0;
  99   2          }
 100   1      
 101   1          CS = 1; // Deselect ET2046
 102   1          return adc_value;
 103   1      }
