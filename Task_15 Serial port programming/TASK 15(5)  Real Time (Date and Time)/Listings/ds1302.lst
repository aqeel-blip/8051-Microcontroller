  73          // ---- Set the DS1302 time and date ----
  74          void DS1302_Set_Time(unsigned char h, unsigned char m, unsigned char s,
  75                               unsigned char d, unsigned char mon, unsigned char y) {
  76   1          // Disable write protection
  77   1          DS1302_Write(0x8E, 0x00);
  78   1          
  79   1          // Write seconds (clear clock halt bit – bit7 = 0)
  80   1          DS1302_Write(0x80, Bin_to_BCD(s) & 0x7F);
