  94   2              month = (rx_buffer[3] - '0') * 10 + (rx_buffer[4] - '0');
  95   2              year  = (rx_buffer[6] - '0') * 1000 + (rx_buffer[7] - '0') * 100 +
  96   2                      (rx_buffer[8] - '0') * 10   + (rx_buffer[9] - '0');
  97   2              UART_SendString("Date Updated!\r\n");
  98   2          } 
