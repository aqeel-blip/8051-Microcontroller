  85          // --- ADC Function ---
  86          unsigned int Read_ADC(unsigned char cmd) {
  87   1          unsigned char i;
  88   1          unsigned int dat = 0;
  89   1          
  90   1          CS = 0; DCLK = 0;
  91   1          for(i=0; i<8; i++) {
  92   2              DIN = (cmd >> (7-i)) & 0x01;
