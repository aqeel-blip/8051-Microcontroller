   4          /* 1 kHz: half-period ticks = TICK_HZ / (2 * GEN_HZ) = 460.8 -> 461 */
   5          #define HALF_PERIOD_TICKS  (((TICK_HZ) + GEN_HZ) / (GEN_HZ * 2UL))
   6          #define T0_RELOAD          (65536UL - HALF_PERIOD_TICKS)
   7          #define T0_TH              ((unsigned char)(T0_RELOAD >> 8))
   8          #define T0_TL              ((unsigned char)(T0_RELOAD & 0xFF))
   9          
  10          sbit GEN_PIN = P1^0;
  11          
  12          static void t0_reload(void) {
  13   1          TH0 = T0_TH;
  14   1          TL0 = T0_TL;
  15   1      }
  16          
  17          void timer0_isr(void) interrupt 1 {
  18   1          t0_reload();
  19   1          GEN_PIN = !GEN_PIN;
  20   1      }
  21          
  22          void freq_gen_init(void) {
  23   1          GEN_PIN = 0;
  24   1          /* Keep Timer 1 bits; only program Timer 0 mode 1 */
  25   1          TMOD = (TMOD & 0xF0) | 0x01;
  26   1          t0_reload();
  27   1          ET0 = 1;
  28   1          TR0 = 1;
  29   1      }
  30          
  31          unsigned int freq_gen_get_hz(void) {
