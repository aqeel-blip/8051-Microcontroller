 226   2              if(key == 'C') {
 227   3                  current_state = (current_state + 1) % 3;
 228   3                  lcd_cmd(0x01); // Clear display on state change
 229   3                  delay_ms(100);
 230   3                  continue;
 231   3              }
 232   2              
