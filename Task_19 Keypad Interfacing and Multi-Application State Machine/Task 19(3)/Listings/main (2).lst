 179          // --- Calculator App ---
 180          void run_calc_mode(char key) {
 181   1          static int num1 = 0, num2 = 0;
 182   1          static char op = 0;
 183   1          static unsigned char step = 0;
 184   1          
 185   1          if(step == 0) {
 186   2              lcd_set_cursor(0, 0); lcd_str("CALCULATOR");
 187   2              lcd_set_cursor(1, 0); lcd_str("Ready...        ");
 188   2              num1 = 0; num2 = 0; op = 0; step = 1;
 189   2          }
 190   1          
 191   1          if(key >= '0' && key <= '9') {
 192   2              if(op == 0) {
 193   3                  num1 = (num1 * 10) + (key - '0');
 194   3                  lcd_set_cursor(1, 0); lcd_num(num1);
 195   3              } else {
 196   3                  num2 = (num2 * 10) + (key - '0');
 197   3                  lcd_set_cursor(1, 5); lcd_num(num2);
 198   3              }
 199   2          } else if(key == '+' || key == '-' || key == '*' || key == '/') {
 200   2              op = key;
 201   2              lcd_set_cursor(1, 4); lcd_char(op);
 202   2          } else if(key == '=') {
 203   2              int res = 0;
 204   2              if(op == '+') res = num1 + num2;
 205   2              if(op == '-') res = num1 - num2;
 206   2              if(op == '*') res = num1 * num2;
 207   2              if(op == '/' && num2 != 0) res = num1 / num2;
 208   2              
 209   2              lcd_set_cursor(1, 8); lcd_char('=');
 210   2              lcd_num(res);
 211   2              step = 0; // Reset after equals
 212   2          }
 213   1      }
