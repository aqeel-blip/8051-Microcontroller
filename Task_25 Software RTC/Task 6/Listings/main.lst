 186          static void apply_measurement(void) {
 187   1          unsigned int ticks;
 188   1          unsigned long f;
 189   1          bit paint;
 190   1      
 191   1          paint = 0;
 192   1      
 193   1          if (period_ovf) {
 194   2              period_ovf = 0;
 195   2              cnt_err = 1;
 196   2              cnt_ovf = 1;
 197   2              refresh_seg_values();
 198   2              lcd_show();
