   1          /*
   2           * Task 26: Frequency counter (loopback) + LCD + 8-digit 7-seg
   3           *
   4           * Crystal Y2 = 12 MHz, 12T machine cycle => 1 timer tick = 1 us.
   5           *
   6           * Wiring (same board, one Dupont jumper):
   7           *   P1.0 (J20 pin 8, next to VCC/RP7)  --->  P3.2 / INT0 (J29 pin 6)
   8           *   Do NOT feed a >5 V generator into INT0.
   9           *
  10           * LCD1602 (schematic J2):
  11           *   D0..D7 = P0, RS = P2.6, RW = P2.5, EN = P2.7
  12           *
  13           * 8-digit 7-seg:
  14           *   segments via 74HC245 on P0 (shared with LCD data)
  15           *   digit select 74HC138 A/B/C = P2.2 / P2.3 / P2.4
  16           *     Y0 = LED1 (rightmost) ... Y7 = LED8 (leftmost)
  17           *
  18           * LCD:
  19           *   line 1 = generated frequency (Timer 0 square wave on P1.0)
  20           *   line 2 = counted frequency (INT0 period on Timer 1)
  21           *
  22           * 7-seg:
  23           *   left 4 digits  = generated Hz
  24           *   right 4 digits = counted Hz  (or -------- on overflow)
  25           */
  26          
  27          #include <reg51.h>
  28          #include "lcd.h"
  29          
  30          #define FOSC            12000000UL
  31          #define TICK_HZ         (FOSC / 12UL)     /* 1 MHz */
  32          #define GEN_HZ          1000UL            /* 1 kHz target */
  33          #define HALF_PERIOD_US  (500000UL / GEN_HZ)   /* 500 us */
  34          
  35          /* Timer 0 reload for HALF_PERIOD_US ticks (mode 1, 16-bit) */
  36          #define T0_RELOAD       (65536UL - HALF_PERIOD_US)
  37          #define T0_TH           ((unsigned char)(T0_RELOAD >> 8))
  38          #define T0_TL           ((unsigned char)(T0_RELOAD & 0xFF))
  39          
  40          sbit GEN_PIN = P1^0;   /* square-wave output */
  41          
  42          /* ---- measurement (INT0 + Timer 1) ---- */
  43          volatile unsigned int period_ticks;
  44          volatile bit period_ready;
  45          volatile bit period_ovf;
  46          volatile bit measuring;
  47          
  48          unsigned int gen_freq = (unsigned int)GEN_HZ;
  49          unsigned int cnt_freq;
  50          bit cnt_err = 1;       /* no valid sample yet */
  51          bit cnt_ovf;
  52          unsigned char lcd_hold;
  53          
  54          /* ---- 7-seg, common cathode, gfedcba on P0 ---- */
C51 COMPILER V9.60.7.0   MAIN                                                              09/23/2026 15:13:21 PAGE 2   

  55          unsigned char seg_buf[8];
  56          code unsigned char SEG_NUM[] = {
  57              0x3F, 0x06, 0x5B, 0x4F, 0x66,
  58              0x6D, 0x7D, 0x07, 0x7F, 0x6F
  59          };
  60          #define SEG_DASH  0x40
  61          #define SEG_BLANK 0x00
  62          
  63          static void t0_reload(void) {
  64   1          TH0 = T0_TH;
  65   1          TL0 = T0_TL;
  66   1      }
  67          
  68          /* 1 kHz (or GEN_HZ) square wave on P1.0 */
  69          void timer0_isr(void) interrupt 1 {
  70   1          t0_reload();
  71   1          GEN_PIN = !GEN_PIN;
  72   1      }
  73          
  74          /* Timer 1 overflow: period longer than 65536 us => too slow */
  75          void timer1_isr(void) interrupt 3 {
  76   1          TR1 = 0;
  77   1          measuring = 0;
  78   1          period_ovf = 1;
  79   1      }
  80          
  81          /*
  82           * Consecutive INT0 edges (8051 hardware is falling-edge when IT0=1).
  83           * Period between edges is the signal period for a square wave, so
  84           * frequency is the same as rising-edge-to-rising-edge.
  85           */
  86          void int0_isr(void) interrupt 0 {
  87   1          unsigned int t;
  88   1      
  89   1          if (!measuring) {
  90   2              TL1 = 0;
  91   2              TH1 = 0;
  92   2              TF1 = 0;
  93   2              TR1 = 1;
  94   2              measuring = 1;
  95   2          } else {
  96   2              TR1 = 0;
  97   2              t = ((unsigned int)TH1 << 8) | TL1;
  98   2              TL1 = 0;
  99   2              TH1 = 0;
 100   2              TF1 = 0;
 101   2              TR1 = 1;
 102   2              period_ticks = t;
 103   2              period_ready = 1;
 104   2          }
 105   1      }
