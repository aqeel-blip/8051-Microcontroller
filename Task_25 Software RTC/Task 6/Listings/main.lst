 224   1          /* LCD is slow and shares P0 with 7-seg — refresh it ~5 times/s at 1 kHz */
 225   1          lcd_hold++;
 226   1          if (paint || lcd_hold >= 200) {
 227   2              lcd_hold = 0;
 228   2              lcd_show();
 229   2          }
 230   1      }
