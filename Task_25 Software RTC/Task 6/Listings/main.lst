 134          /* Digit i: 0 = LED1 (right), 7 = LED8 (left). Keep LCD control bits P2.5-7. */
 135          static void show_digit(unsigned char i) {
 136   1          P0 = 0x00;
 137   1          P2 = (P2 & 0xE3) | ((i & 0x07) << 2);
 138   1          P0 = seg_buf[i];
 139   1      }
