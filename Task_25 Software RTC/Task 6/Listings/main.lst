 107          static void digits_to_seg(unsigned char right_of, unsigned int val, bit err) {
 108   1          unsigned char i;
 109   1      
 110   1          /* right_of: index of least-significant digit in seg_buf
 111   1             seg_buf[7] = leftmost (LED8), seg_buf[0] = rightmost (LED1) */
 112   1          if (err) {
 113   2              for (i = 0; i < 4; i++)
 114   2                  seg_buf[right_of + i] = SEG_DASH;
 115   2              return;
 116   2          }
C51 COMPILER V9.60.7.0   MAIN                                                              09/23/2026 15:13:21 PAGE 3   

 117   1          for (i = 0; i < 4; i++) {
 118   2              seg_buf[right_of + i] = SEG_NUM[val % 10];
 119   2              val /= 10;
 120   2          }
 121   1      }
 122          
 123          static void refresh_seg_values(void) {
 124   1          unsigned int g, c;
 125   1      
 126   1          g = gen_freq;
 127   1          if (g > 9999) g = 9999;
 128   1          digits_to_seg(4, g, 0);          /* LED8..LED5 generated */
 129   1          c = cnt_freq;
 130   1          if (!cnt_err && c > 9999) c = 9999;
 131   1          digits_to_seg(0, c, cnt_err);    /* LED4..LED1 counted */
 132   1      }
