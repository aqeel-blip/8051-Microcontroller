 128          void update_time_structure(void) {
 129   1          current_time.second++;
 130   1          if (current_time.second >= 60) {
 131   2              current_time.second = 0;
 132   2              current_time.minute++;
 133   2              if (current_time.minute >= 60) {
 134   3                  current_time.minute = 0;
 135   3                  current_time.hour++;
 136   3                  if (current_time.hour >= 24) {
 137   4                      current_time.hour = 0;
 138   4                      current_time.day++;
 139   4                      if (current_time.day > get_days_in_month(current_time.month, current_time.year)) {
 140   5                          current_time.day = 1;
 141   5                          current_time.month++;
 142   5                          if (current_time.month > 12) {
 143   6                              current_time.month = 1;
 144   6                              current_time.year++;
 145   6                          }
 146   5                      }
 147   4                  }
 148   3              }
 149   2          }
 150   1      }
 151          
 152          void update_lcd(void) {
 153   1          lcd_set_cursor(0, 0);
 154   1          lcd_write_string("Time: ");
 155   1          lcd_write_2digit(current_time.hour);
