 117          unsigned char is_leap_year(unsigned int year) {
 118   1          if ((year % 4 == 0 && year % 100 != 0) || (year % 400 == 0)) return 1;
 119   1          return 0;
 120   1      }
 121          
 122          unsigned char get_days_in_month(unsigned int month, unsigned int year) {
 123   1          if (month == 2) return is_leap_year(year) ? 29 : 28;
 124   1          if (month == 4 || month == 6 || month == 9 || month == 11) return 30;
 125   1          return 31;
 126   1      }
