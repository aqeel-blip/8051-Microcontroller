 162   1          lcd_write_string("Date: ");
 163   1          lcd_write_2digit(current_time.day);
 164   1          lcd_write_data('/');
 165   1          lcd_write_2digit(current_time.month);
 166   1          lcd_write_data('/');
 167   1          lcd_write_4digit(current_time.year);
 168   1      }
