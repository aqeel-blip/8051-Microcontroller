   1          /************************************************************
   2           * Task 5 - Software RTC with PC time-setting over Serial
   3           * Board : STC89C52 @ 11.0592 MHz (see note below if 12 MHz)
   4           * LCD   : Data=P0, RS=P2.6, RW=P2.5, EN=P2.7
   5           * UART  : P3.0(RXD), P3.1(TXD) via CH340 USB-TTL
   6           *
   7           * PC -> MCU command format (14 digits + Enter):
   8           *   HHMMSSDDMMYYYY
   9           *   e.g.  11262418092026<CR>   = 11:26:24 18/09/2026
  10           * Other commands:
  11           *   ?<CR>  -> MCU replies with current time
  12           ************************************************************/
  13          #include <reg51.h>
  14          #include "lcd.h"
  15          
  16          struct __time {
  17              unsigned int hour;
  18              unsigned int minute;
  19              unsigned int second;
  20              unsigned int day;
  21              unsigned int month;
  22              unsigned int year;
  23          };
  24          
  25          struct __time current_time = {10, 5, 30, 22, 9, 2026};
  26          
  27          volatile bit second_flag = 0;
  28          unsigned int timer_count = 0;
  29          
  30          /* ---------------- UART variables ---------------- */
  31          volatile bit  rx_ready = 0;                 // a full command line arrived
  32          unsigned char rx_buf[20];
  33          unsigned char rx_index = 0;
  34          
  35          /* ---------------- UART driver ---------------- */
  36          void uart_init(void) {
  37   1          TMOD &= 0x0F;           // clear Timer1 field
  38   1          TMOD |= 0x20;           // Timer1, Mode 2 (8-bit auto reload)
  39   1          TH1  = 0xFD;            // 9600 baud @ 11.0592 MHz
  40   1          TL1  = 0xFD;            // NOTE: if your crystal is 12.000 MHz use
  41   1                                  //       TH1=TL1=0xF3 and 2400 baud instead!
  42   1          SCON = 0x50;            // UART mode 1, REN=1
  43   1          TR1  = 1;
  44   1          ES   = 1;               // enable UART interrupt
  45   1          EA   = 1;
  46   1      }
  47          
  48          void uart_putc(char c) {
  49   1          SBUF = c;
  50   1          while (TI == 0);
  51   1          TI = 0;
  52   1      }
  53          
  54          void uart_puts(char *s) {
C51 COMPILER V9.60.7.0   MAIN                                                              09/22/2026 10:01:04 PAGE 2   

  55   1          while (*s) uart_putc(*s++);
  56   1      }
  57          
  58          void uart_isr(void) interrupt 4 {
  59   1          if (RI) {
  60   2              RI = 0;
  61   2              rx_buf[rx_index] = SBUF;
  62   2              if (rx_buf[rx_index] == '\r' || rx_buf[rx_index] == '\n') {
  63   3                  rx_buf[rx_index] = 0;           // terminate string
  64   3                  if (rx_index > 0) rx_ready = 1;
  65   3                  rx_index = 0;
  66   3              } else {
  67   3                  if (rx_index < sizeof(rx_buf) - 1) rx_index++;
  68   3              }
  69   2          }
  70   1          if (TI) TI = 0;
  71   1      }
  72          
  73          /* ---------------- command parser ---------------- */
  74          /* expects exactly 14 digits: HHMMSSDDMMYYYY            */
  75          bit parse_and_set_time(unsigned char *s) {
  76   1          unsigned char i;
  77   1          unsigned char v[14];
  78   1      
  79   1          for (i = 0; i < 14; i++)
  80   1              if (s[i] < '0' || s[i] > '9') return 0;
  81   1      
  82   1          for (i = 0; i < 14; i++) v[i] = s[i] - '0';
  83   1      
  84   1          current_time.hour   = v[0]*10 + v[1];
  85   1          current_time.minute = v[2]*10 + v[3];
  86   1          current_time.second = v[4]*10 + v[5];
  87   1          current_time.day    = v[6]*10 + v[7];
  88   1          current_time.month  = v[8]*10 + v[9];
  89   1          current_time.year   = v[10]*1000 + v[11]*100 + v[12]*10 + v[13];
  90   1      
  91   1          if (current_time.hour > 23 || current_time.minute > 59 ||
  92   1              current_time.second > 59 || current_time.day < 1   ||
  93   1              current_time.day > 31  || current_time.month < 1   ||
  94   1              current_time.month > 12) return 0;
  95   1      
  96   1          return 1;
  97   1      }
  98          
  99          void send_current_time(void) {
 100   1          uart_putc('T'); uart_putc('=');
 101   1          uart_putc(current_time.hour/10 + '0');   uart_putc(current_time.hour%10 + '0');
 102   1          uart_putc(':');
 103   1          uart_putc(current_time.minute/10 + '0'); uart_putc(current_time.minute%10 + '0');
 104   1          uart_putc(':');
 105   1          uart_putc(current_time.second/10 + '0'); uart_putc(current_time.second%10 + '0');
 106   1          uart_putc(' ');
 107   1          uart_putc(current_time.day/10 + '0');    uart_putc(current_time.day%10 + '0');
 108   1          uart_putc('/');
 109   1          uart_putc(current_time.month/10 + '0');  uart_putc(current_time.month%10 + '0');
 110   1          uart_putc('/');
 111   1          uart_putc(current_time.year/1000 + '0'); uart_putc((current_time.year/100)%10 + '0');
 112   1          uart_putc((current_time.year/10)%10 + '0'); uart_putc(current_time.year%10 + '0');
 113   1          uart_putc('\r'); uart_putc('\n');
 114   1      }
